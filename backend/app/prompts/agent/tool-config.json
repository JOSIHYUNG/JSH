{
  "version": "agent-tools-v1",
  "parallel_tool_calls": false,
  "tools": [
    {
      "type": "function",
      "name": "search_knowledge",
      "description": "Search the local second brain for up to three relevant document chunks.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {"query": {"type": "string", "minLength": 2, "maxLength": 1000}},
        "required": ["query"],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "explore_node",
      "description": "Explore connected graph nodes and matching source excerpts.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {"node_ids": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}}},
        "required": ["node_ids"],
        "additionalProperties": false
      }
    },
    {"type": "web_search"}
  ]
}
